{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "lint": {
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "biome.json",
        "pyproject.toml",
        "**/*.{ts,tsx,js,jsx,json,jsonc,py}"
      ]
    },
    "format": {
      "cache": false
    },
    "format:check": {
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "biome.json",
        "pyproject.toml"
      ]
    },
    "clean": {
      "cache": false
    }
  }
}
